{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "team_id",
    "version",
    "name",
    "outputs",
    "gates"
  ],
  "properties": {
    "team_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_budget_usd": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false
}