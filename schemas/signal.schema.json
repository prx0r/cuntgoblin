{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketSignal",
  "type": "object",
  "required": [
    "signal_id",
    "entity_id",
    "kind",
    "score",
    "method",
    "observation_ids"
  ],
  "properties": {
    "signal_id": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "window": {
      "type": [
        "string",
        "null"
      ]
    },
    "method": {
      "type": "string"
    },
    "source_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
