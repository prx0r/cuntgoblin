{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Certificate",
  "description": "MVP certification result",
  "type": "object",
  "properties": {
    "schema": {"type": "string"},
    "product": {"type": "string"},
    "certified_at": {"type": "string", "format": "date-time"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test": {"type": "string"},
          "status": {"type": "string", "enum": ["PASS", "FAIL"]},
          "detail": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "passed": {"type": "integer"},
        "failed": {"type": "integer"}
      }
    },
    "certificate": {
      "type": "string",
      "enum": ["PASS", "CONDITIONAL PASS", "FAIL"]
    }
  },
  "required": ["schema", "product", "certified_at", "results", "certificate"]
}
