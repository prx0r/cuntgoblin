{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product",
  "description": "A product derived from an idea",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "stage": {
      "type": "string",
      "enum": ["idea", "research", "experiment", "mvp", "published", "deployed"]
    },
    "idea_id": {"type": "string"},
    "repo_url": {"type": "string"},
    "deploy_url": {"type": "string"},
    "certificate_status": {
      "type": "string",
      "enum": ["pending", "pass", "fail"]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "unique_users": {"type": "integer"},
        "api_calls": {"type": "integer"},
        "revenue": {"type": "number"}
      }
    }
  },
  "required": ["id", "name"]
}
